# AI keys — copy to .env (gitignored). VITE_* are read by the browser bundle.
# Gemini: REST uses ?key= on the URL (never Authorization: Bearer). Same key works in Supabase Edge secrets as GEMINI_API_KEY.
VITE_GOOGLE_AI_KEY="AIza_YOUR_GEMINI_API_KEY"
GEMINI_API_KEY="AIza_YOUR_GEMINI_API_KEY"

VITE_OPENAI_API_KEY="sk-YOUR_OPENAI_API_KEY"
OPENAI_API_KEY="sk-YOUR_OPENAI_API_KEY"
VITE_ANTHROPIC_API_KEY="sk-ant-YOUR_ANTHROPIC_API_KEY"

# APP_URL: production URL (Vercel / Edge Functions)
APP_URL="https://your-app.vercel.app"

# Supabase — copy to .env (gitignored). Never commit real keys.
# Only VITE_* values are exposed to the browser. Keep service role server-side.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PROJECT_ID="YOUR_PROJECT_REF"
SUPABASE_ACCESS_TOKEN="sbp_YOUR_PERSONAL_ACCESS_TOKEN"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_SERVICE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Recraft — SVG nativo. Token ONLY on the Edge Function. Never VITE_.
RECRAFT_API_TOKEN="YOUR_RECRAFT_API_TOKEN"

# Spotify — Edge Function only (Client Credentials). Never VITE_.
SPOTIFY_CLIENT_ID="YOUR_SPOTIFY_CLIENT_ID"
SPOTIFY_CLIENT_SECRET="YOUR_SPOTIFY_CLIENT_SECRET"

# YouTube Data API v3 — Edge Function only. Never VITE_. Restricted by API, not by origin.
YOUTUBE_API_KEY="YOUR_YOUTUBE_API_KEY"

# E2E tests — copy real values to .env only (gitignored)
E2E_BASE_URL="http://127.0.0.1:3001"
E2E_TEST_EMAIL="your-test-email@example.com"
E2E_TEST_PASSWORD="your-test-password"
